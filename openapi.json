{
  "openapi": "3.1.0",
  "info": {
    "title": "Firstember Wallet API",
    "version": "1.0.0",
    "description": "Unified MCP wallet actions for Ethereum and Solana."
  },
  "servers": [
    {
      "url": "https://astrology-strike-define-karaoke.trycloudflare.com"
    }
  ],
  "paths": {
    "/call": {
      "post": {
        "summary": "Execute a Firstember wallet action",
        "operationId": "mcp_call",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "show_wallets",
                "connect_wallet",
                "disconnect_wallet",
                "send_prompt",
                "confirm_send"
              ]
            },
            "description": "Firstember action to execute"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chain": {
                    "type": "string",
                    "enum": ["ethereum", "solana"],
                    "description": "Blockchain to operate on"
                  },
                  "provider": {
                    "type": "string",
                    "description": "Wallet provider name"
                  },
                  "to": {
                    "type": "string",
                    "description": "Recipient address"
                  },
                  "amount": {
                    "type": "string",
                    "description": "Amount to send"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP action executed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "result"],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "result": {
                      "type": "object",
                      "description": "UI card or wallet action response",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
